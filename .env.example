# ==============================================================================
# Teams Avatar Agent - environment template
# ------------------------------------------------------------------------------
# Copy to .env and fill in. .env is in .gitignore - never commit it.
# Loaded by: Python (python-dotenv) in agent/, C# (DotNetEnv) in bot/.
# ==============================================================================

# -----------------------------------------------------------------------------
# LiveKit (cloud.livekit.io - free tier is fine for dev)
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# -----------------------------------------------------------------------------
# Anthropic - Claude Sonnet 4.5 (https://console.anthropic.com)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Deepgram - Nova-3 streaming STT (https://deepgram.com)
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=

# -----------------------------------------------------------------------------
# ElevenLabs - Flash v2.5 streaming TTS (https://elevenlabs.io)
# Env var name MUST be ELEVEN_API_KEY (the plugin reads this directly).
# -----------------------------------------------------------------------------
ELEVEN_API_KEY=
# Pick a voice from the ElevenLabs voice library and paste its id here.
# https://elevenlabs.io/app/voice-library  (or My Voices for cloned voices)
ELEVEN_VOICE_ID=

# -----------------------------------------------------------------------------
# Avatar provider switch — bey | liveavatar  (default: bey)
# -----------------------------------------------------------------------------
AVATAR_PROVIDER=bey

# -----------------------------------------------------------------------------
# Beyond Presence - photoreal avatar (https://bey.dev)
# -----------------------------------------------------------------------------
BEY_API_KEY=
# Pick an avatar from the Beyond Presence console and paste its id here.
BEY_AVATAR_ID=

# -----------------------------------------------------------------------------
# HeyGen LiveAvatar - photoreal avatar (https://liveavatar.com)
# Used in LITE mode (1 credit/min, BYO ElevenLabs TTS).
# -----------------------------------------------------------------------------
LIVEAVATAR_API_KEY=
LIVEAVATAR_AVATAR_ID=

# -----------------------------------------------------------------------------
# Azure / Microsoft Graph - filled after completing docs/azure-setup-runbook.md
# -----------------------------------------------------------------------------
# Entra ID (Azure AD) app registration
TENANT_ID=
APP_CLIENT_ID=
APP_CLIENT_SECRET=

# Azure Bot resource - usually identical to APP_CLIENT_ID for app-hosted media
BOT_APP_ID=

# Public DNS name of this host. Required by the Graph Communications media bot.
# The bot must be reachable at https://${BOT_PUBLIC_FQDN}/api/calling.
BOT_PUBLIC_FQDN=

# Local callback/port configuration for the bot
BOT_CALLING_PORT=443
BOT_MEDIA_PORT=8445
BOT_INSTANCE_PUBLIC_IP=

# Cloudflare API token (Zone:DNS:Edit on the bot's zone) for Let's Encrypt
# DNS-01 challenge in scripts/install-tls-cert.ps1.
CLOUDFLARE_API_TOKEN=

# -----------------------------------------------------------------------------
# Agent runtime knobs
# -----------------------------------------------------------------------------
# Agent identity (used in disclosure and chat messages)
AGENT_NAME=Iris
AGENT_ROOM_PREFIX=meeting
LOG_LEVEL=INFO
